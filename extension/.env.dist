# Fingermile Extension — Environment Variables
# Copy this file to .env and fill in your values.

# REQUIRED: Clerk publishable key
# Found in Clerk Dashboard → API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# REQUIRED: Clerk sync host (your hosted web app URL)
# This is the web app that handles Clerk authentication
VITE_CLERK_SYNC_HOST=https://your-web-app.railway.app

# REQUIRED: Backend API URL
VITE_BACKEND_URL=https://your-backend.railway.app

# REQUIRED: Web dashboard URL (same as sync host)
VITE_WEB_DASHBOARD_URL=https://your-web-app.railway.app

# REQUIRED: Clerk Frontend API (your Clerk instance URL)
VITE_CLERK_FRONTEND_API=https://your-instance.clerk.accounts.dev
