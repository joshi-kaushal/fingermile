# Fingermile Backend — Environment Variables
# Copy this file to .env and fill in your values.

# REQUIRED: PostgreSQL connection string (Railway auto-sets this via Postgres plugin)
# Format: postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fingermile

# REQUIRED: Clerk JWKS URL for JWT verification
# Found in Clerk Dashboard → your instance → .well-known/jwks.json
# Format: https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=

# OPTIONAL: Set to "true" to skip Clerk JWT verification (local dev only)
BYPASS_AUTH=false
